# Bot credentials
TOKEN=your_main_bot_token
DEBUG_TOKEN=your_debug_bot_token

# PostgreSQL database
# For Docker, DB_HOST should be 'db'
DB_HOST=db
DB_PASSWORD=your_secure_database_password
DB_PORT=5432
DB_NAME=lumin_beta

# Lavalink (for music playback)
# For Docker, LAVALINK_URI should be 'http://lavalink:2333'
# Otherwise 'http://localhost:2333'
LAVALINK_URI=http://lavalink:2333
LAVALINK_PASSWORD=your_secure_lavalink_password