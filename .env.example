# Bot credentials
TOKEN=your_main_bot_token
DEBUG_TOKEN=your_debug_bot_token

# PostgreSQL database
# For Docker, DB_HOST should be 'db'
DB_HOST=db
DB_PASSWORD=your_secure_database_password
DB_PORT=5432
DB_NAME=lumin_beta

# Lavalink (for music playback)
# For Docker, LAVALINK_URI should be 'http://lavalink:2333'
# Otherwise 'http://localhost:2333'
LAVALINK_URI=http://lavalink:2333
LAVALINK_PASSWORD=your_secure_lavalink_password

# Sentry - completely optional, we use it
# to see error messages on a dashboard
SENTRY_DSN=sentry_sdk_dsn

# Clustering - for production
# It's not recommended to mess with these values when self-hosting.
BOT_MODE=standalone  # or "clustered"
# If you use BOT_MODE=standalone, settings below will be ignored.
SHARD_COUNT=64   # A shard usually contains 1000 servers
SHARDS_PER_CLUSTER=16  # One cluster (process) will manage up to 16 shards
# CLUSTER_ID=cluster-0  # Leave unset for automatic cluster ID assignment per replica
REDIS_URL=redis://redis:6379/0
REDIS_MSG_URL=redis://redis:6379/1
# DISCORD_PROXY_URL=http://twilight-proxy:3000/api/v10
